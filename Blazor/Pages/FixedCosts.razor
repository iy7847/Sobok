@page "/fixedcosts"
@using Supabase.Interfaces
@using Supabase.Postgrest
@using ProfitMate_V2.Models
@using ProfitMate_V2.Shared
@inject Supabase.Client Supabase
@inject IJSRuntime JS

<PageTitle>고정비 관리</PageTitle>

<div class="container mt-4 pb-5">
    <!-- 1. 헤더 영역 -->
    <!-- [수정] 버튼 크기 복구: flex-column 제거 및 버튼 너비 자동(auto)으로 변경 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div style="min-width: 0; margin-right: 10px;">
            <h3 class="fw-bold text-dark m-0 text-truncate">💸 고정비 관리</h3>
            <p class="text-muted small m-0 text-truncate">월세, 인건비 등 매월 발생하는 고정 지출을 관리합니다.</p>
        </div>
        <!-- [수정] w-100 제거, flex-shrink-0 유지 -->
        <button class="btn btn-primary rounded-pill px-4 shadow-sm text-nowrap flex-shrink-0" @onclick="ShowAddForm">
            <i class="bi bi-plus-lg me-1"></i> 새 항목 추가
        </button>
    </div>

    <!-- 2. 요약 카드 (월 총 지출) -->
    <div class="card border-0 shadow-sm mb-4 bg-primary bg-opacity-10">
        <div class="card-body d-flex align-items-center justify-content-between p-4">
            <div>
                <h6 class="text-primary fw-bold text-uppercase mb-1">월 예상 총 고정비</h6>
                <div class="text-muted small">이 금액이 제품 원가에 분배됩니다.</div>
            </div>
            <div class="text-end">
                <h2 class="fw-bold text-dark m-0">@totalAmount.ToString("N0")원</h2>
            </div>
        </div>
    </div>

    <!-- 3. 입력 및 수정 폼 -->
    @if (isFormVisible)
    {
        <div class="card shadow mb-4 border-0">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold text-primary">
                    @(newItem.Id == 0 ? "✨ 새 고정비 등록" : "✏️ 고정비 수정")
                </h5>
                <button class="btn btn-close" @onclick="HideAddForm"></button>
            </div>
            <div class="card-body bg-light">
                <EditForm Model="newItem" OnValidSubmit="SaveItem">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">항목명</label>
                            <InputText class="form-control" @bind-Value="newItem.Name" placeholder="예: 월세, 전기세" />
                        </div>

                        <div class="col-md-3">
                            <!-- [수정] CurrencyInput 적용 -->
                            <CurrencyInput Label="월 지출 금액"
                                           @bind-Value="newItem.Amount"
                                           Unit="원"
                                           Placeholder="0" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-bold">결제일 (매월)</label>
                            <div class="input-group">
                                <InputNumber class="form-control" @bind-Value="newItem.PaymentDay" min="1" max="31" />
                                <span class="input-group-text">일</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">메모</label>
                            <InputText class="form-control" @bind-Value="newItem.Description" placeholder="비고 사항" />
                        </div>

                        <div class="col-12 text-end pt-3 border-top mt-3">
                            <button type="button" class="btn btn-outline-secondary me-2" @onclick="HideAddForm">취소</button>
                            <button type="submit" class="btn btn-primary px-4">저장</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- 4. 리스트 영역 -->
    @if (fixedCosts == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">데이터를 불러오는 중입니다...</p>
        </div>
    }
    else if (fixedCosts.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded-3 border border-dashed">
            <i class="bi bi-wallet2 display-4 text-muted mb-3 d-block"></i>
            <p class="text-muted m-0 fw-bold">등록된 고정비 내역이 없습니다.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-light">
                        <tr class="text-muted text-uppercase small">
                            <th class="ps-4">항목명</th>
                            <th class="text-end">금액</th>
                            <th class="text-center">결제일</th>
                            <th>메모</th>
                            <th class="text-end pe-4" style="width: 150px;">관리</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in fixedCosts)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.Name</td>
                                <td class="text-end fw-bold text-danger">@item.Amount.ToString("N0")원</td>
                                <td class="text-center text-muted small">매월 @(item.PaymentDay)일</td>
                                <td class="text-muted small">@item.Description</td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditForm(item)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(item)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<FixedCost>? fixedCosts = null;
    private FixedCost newItem = new FixedCost();
    private bool isFormVisible = false;
    private double totalAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var result = await Supabase.From<FixedCost>()
                .Order("created_at", Constants.Ordering.Descending)
                .Get();

            fixedCosts = result.Models;
            totalAmount = fixedCosts.Sum(x => x.Amount);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            fixedCosts = new List<FixedCost>();
        }
    }

    private void ShowAddForm()
    {
        newItem = new FixedCost { PaymentDay = 1 };
        isFormVisible = true;
    }

    private void ShowEditForm(FixedCost item)
    {
        // 값 복사
        newItem = new FixedCost
        {
            Id = item.Id,
            Name = item.Name,
            Amount = item.Amount,
            PaymentDay = item.PaymentDay,
            Description = item.Description,
            CreatedAt = item.CreatedAt
        };
        isFormVisible = true;
    }

    private void HideAddForm()
    {
        isFormVisible = false;
    }

    private async Task SaveItem()
    {
        try
        {
            if (newItem.Id == 0)
            {
                newItem.CreatedAt = DateTime.Now;
                await Supabase.From<FixedCost>().Insert(newItem);
            }
            else
            {
                await Supabase.From<FixedCost>().Update(newItem);
            }

            await LoadData();
            isFormVisible = false;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"저장 실패: {ex.Message}");
        }
    }

    private async Task DeleteItem(FixedCost item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"정말 '{item.Name}' 항목을 삭제하시겠습니까?"))
        {
            await Supabase.From<FixedCost>().Delete(item);
            await LoadData();
        }
    }
}