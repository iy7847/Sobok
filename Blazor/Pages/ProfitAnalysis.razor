@page "/profitanalysis"
@using Supabase.Interfaces
@using Supabase.Postgrest
@using ProfitMate_V2.Models
@using ProfitMate_V2.Shared
@inject Supabase.Client Supabase
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>마진 분석 - 소복</PageTitle>

<div class="container mt-4 pb-5">
    <!-- 1. 헤더 & 컨트롤 패널 -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div style="min-width: 0;">
            <h3 class="fw-bold text-dark m-0 text-truncate">📈 마진 분석 리포트</h3>
            <p class="text-muted small m-0 text-truncate">기간별 실제 주문 내역과 지출 내역을 기반으로 수익을 분석합니다.</p>
        </div>
        <div class="d-flex gap-2 align-items-center bg-white p-2 rounded shadow-sm border flex-shrink-0">
            <!-- 날짜 선택 -->
            <input type="month" class="form-control form-control-sm border-0" style="width: 130px;"
                   @bind="selectedMonth" @bind:after="LoadData" />

            <div class="vr"></div>

            <!-- 새로고침 -->
            <button class="btn btn-sm btn-light text-primary" @onclick="LoadData" title="새로고침">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- 2. 분석 옵션 -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3 bg-light rounded">
            <div class="row g-3 align-items-center">

                <!-- 분석 모드 -->
                <div class="col-auto">
                    <div class="d-flex align-items-center">
                        <span class="fw-bold me-3 small text-secondary">분석 모드</span>
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check" name="analysisMode" id="modeForecast" autocomplete="off"
                                   checked="@(isForecastMode)" @onchange="@(() => ChangeMode(true))">
                            <label class="btn btn-sm btn-outline-primary" for="modeForecast">예상(시뮬레이션)</label>

                            <input type="radio" class="btn-check" name="analysisMode" id="modeActual" autocomplete="off"
                                   checked="@(!isForecastMode)" @onchange="@(() => ChangeMode(false))">
                            <label class="btn btn-sm btn-outline-success" for="modeActual">실제(주문기반)</label>
                        </div>
                    </div>
                </div>

                <div class="col-auto d-none d-md-block"><div class="vr h-100"></div></div>

                <!-- 배분 기준 -->
                <div class="col-auto">
                    <div class="d-flex align-items-center">
                        <span class="fw-bold me-3 small text-secondary">비용 배분</span>
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check" name="allocMethod" id="allocQty" autocomplete="off"
                                   checked="@(allocationMethod == "Quantity")" @onchange="@(() => ChangeAllocation("Quantity"))">
                            <label class="btn btn-sm btn-outline-secondary" for="allocQty">판매량 비례</label>

                            <input type="radio" class="btn-check" name="allocMethod" id="allocRev" autocomplete="off"
                                   checked="@(allocationMethod == "Revenue")" @onchange="@(() => ChangeAllocation("Revenue"))">
                            <label class="btn btn-sm btn-outline-secondary" for="allocRev">매출액 비례</label>
                        </div>
                    </div>
                </div>

                <div class="col-auto d-none d-md-block"><div class="vr h-100"></div></div>

                <!-- 추가 보정 (시뮬레이션용) -->
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <span class="fw-bold me-2 small text-danger text-nowrap">가상 추가 지출</span>
                        <div style="width: 120px;">
                            <CurrencyInput Value="@additionalCost"
                                           ValueChanged="@(val => UpdateAdditionalCost(val))"
                                           Unit="원"
                                           Placeholder="0"
                                           InputClass="form-control-sm border-0 shadow-none bg-white" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. 종합 요약 카드 -->
    <div class="row g-3 mb-4">
        <!-- 매출 -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <h6 class="text-secondary text-uppercase x-small fw-bold mb-2">@(isForecastMode ? "예상 매출" : "실제 매출")</h6>
                    <h3 class="fw-bold text-primary mb-1">@totalRevenue.ToString("N0")원</h3>
                    <small class="text-muted" style="font-size: 0.8rem;">판매량: @totalSalesCount.ToString("N0")개</small>
                </div>
            </div>
        </div>
        <!-- 총 지출 -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <h6 class="text-secondary text-uppercase x-small fw-bold mb-2">총 지출 (재료+운영)</h6>
                    <h3 class="fw-bold text-dark mb-1">@((totalVariableCost + TotalOperatingCost).ToString("N0") + "원")</h3>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-warning" role="progressbar"
                             style="width: @(totalRevenue > 0 ? Math.Min((totalVariableCost + TotalOperatingCost) / totalRevenue * 100, 100) : 0)%"></div>
                    </div>
                    <small class="text-muted mt-1 d-block" style="font-size: 0.8rem;">
                        운영비: @TotalOperatingCost.ToString("N0")원 (지출관리 + 보정)
                    </small>
                </div>
            </div>
        </div>
        <!-- 순수익 -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100 @(netProfit >= 0 ? "bg-gradient-success text-white" : "bg-gradient-danger text-white")">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-white-50 text-uppercase fw-bold mb-1">@(isForecastMode ? "예상 순수익" : "실제 순수익")</h6>
                        <h2 class="fw-bold mb-0 display-6">@netProfit.ToString("N0")원</h2>
                    </div>
                    <div class="text-end">
                        <div class="display-4 fw-bold">@(totalRevenue > 0 ? (netProfit / totalRevenue * 100).ToString("F1") : "0")%</div>
                        <span class="text-white-50 small">순이익률</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. 상세 분석 테이블 -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="bi bi-table me-2 text-primary"></i>
                <h6 class="m-0 fw-bold text-dark">제품별 수익성 상세 분석</h6>
            </div>
            <small class="text-muted">
                기준: @(isForecastMode ? "예상 판매량" : $"{selectedMonth:yyyy-MM} 주문 내역")
            </small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead class="bg-light text-muted x-small text-uppercase">
                    <tr>
                        <th class="ps-4">제품명</th>
                        <th class="text-center">판매량</th>
                        <th class="text-end">매출액</th>
                        <th class="text-end text-secondary">재료비(총)</th>
                        <th class="text-end text-primary">운영비 분배</th>
                        <th class="text-end fw-bold bg-light">최종 원가(개당)</th>
                        <th class="text-end">개당 마진</th>
                        <th class="text-center">마진율</th>
                        <th class="text-end pe-4">순수익 기여</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="9" class="text-center py-5"><span class="spinner-border text-primary"></span></td></tr>
                    }
                    else if (analysisList == null || analysisList.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-clipboard-x fs-1 d-block mb-3"></i>
                                분석할 데이터가 없습니다.<br>
                                @(isForecastMode ? "품목 관리에서 예상 판매량을 입력하세요." : "해당 월의 주문 내역이 없습니다.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in analysisList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.Name</td>
                                <td class="text-center">@item.SalesCount.ToString("N0")</td>
                                <td class="text-end">@item.TotalRevenue.ToString("N0")</td>
                                <td class="text-end text-secondary">@item.TotalVariableCost.ToString("N0")</td>
                                <td class="text-end text-primary">@item.AllocatedFixedCost.ToString("N0")</td>
                                <td class="text-end fw-bold bg-light">@item.TotalUnitCost.ToString("N0")</td>
                                <td class="text-end @(item.UnitMargin >= 0 ? "text-success" : "text-danger fw-bold")">
                                    @item.UnitMargin.ToString("N0")
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill @GetMarginBadgeColor(item.MarginRate)">
                                        @item.MarginRate.ToString("F1")%
                                    </span>
                                </td>
                                <td class="text-end pe-4 fw-bold text-dark">
                                    @item.TotalProfit.ToString("N0")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white py-3">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>
                <strong>운영비 분배:</strong> 총 운영비(@TotalOperatingCost.ToString("N0")원)를
                @(allocationMethod == "Quantity" ? "총 판매량으로 나누어 균등 배분" : "매출 비중에 따라 차등 배분")했습니다.
                (지출 관리 내역 @totalExpenses.ToString("N0") + 추가 보정 @additionalCost.ToString("N0"))
            </small>
        </div>
    </div>
</div>

@code {
    public class ProductAnalysisView
    {
        public string Name { get; set; } = "";
        public double SellingPrice { get; set; }
        public double UnitVariableCost { get; set; } // 개당 재료비 (CostPrice)
        public double SalesCount { get; set; } // 판매량

        // 1. 매출액
        public double TotalRevenue => SellingPrice * SalesCount;
        // 2. 총 재료비
        public double TotalVariableCost => UnitVariableCost * SalesCount;

        // 3. 할당된 운영비 (총액)
        public double AllocatedFixedCost { get; set; }

        // 4. 개당 분배된 운영비
        public double UnitFixedCost => SalesCount > 0 ? AllocatedFixedCost / SalesCount : 0;

        // 5. 개당 최종 원가 (재료비 + 분배운영비)
        public double TotalUnitCost => UnitVariableCost + UnitFixedCost;

        // 6. 총 순수익
        public double TotalProfit => TotalRevenue - (TotalVariableCost + AllocatedFixedCost);

        // 7. 개당 마진
        public double UnitMargin => SalesCount > 0 ? TotalProfit / SalesCount : 0;

        // 8. 마진율
        public double MarginRate => TotalRevenue > 0 ? (TotalProfit / TotalRevenue * 100) : 0;
    }

    private List<ProductAnalysisView> analysisList = new();

    private bool isForecastMode = true;
    private string allocationMethod = "Quantity";
    private DateTime selectedMonth = DateTime.Now;

    private double totalRevenue = 0;
    private double totalVariableCost = 0;
    private double totalExpenses = 0; // 지출 관리 테이블 합계

    private double additionalCost = 0; // 시뮬레이션용 보정값
    private double TotalOperatingCost => totalExpenses + additionalCost;

    private double totalSalesCount = 0;
    private double netProfit = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task ChangeMode(bool isForecast)
    {
        isForecastMode = isForecast;
        await LoadData();
    }

    private async Task ChangeAllocation(string method)
    {
        allocationMethod = method;
        CalculateMetrics();
    }

    private void UpdateAdditionalCost(double value)
    {
        additionalCost = value;
        CalculateMetrics();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // 1. 이번 달 지출 내역(Expenses) 총합 조회
            var startOfMonth = new DateTime(selectedMonth.Year, selectedMonth.Month, 1);
            var endOfMonth = startOfMonth.AddMonths(1).AddSeconds(-1);

            var expensesResult = await Supabase.From<Expense>()
                .Where(e => e.ExpenseDate >= startOfMonth && e.ExpenseDate <= endOfMonth)
                .Get();

            totalExpenses = expensesResult.Models.Sum(e => e.Amount);

            // 2. 제품 목록 조회
            var productsResult = await Supabase.From<Item>()
                .Where(x => x.Type == "Product")
                .Get();
            var products = productsResult.Models;

            // 3. 판매량 집계
            Dictionary<string, double> salesData = new();

            if (isForecastMode)
            {
                foreach (var p in products)
                {
                    salesData[p.Name] = p.EstimatedMonthlySales;
                }
            }
            else
            {
                var ordersResult = await Supabase.From<Order>()
                    .Select("id")
                    .Where(o => o.CreatedAt >= startOfMonth && o.CreatedAt <= endOfMonth)
                    .Get();
                var orderIds = ordersResult.Models.Select(o => o.Id).ToList();

                if (orderIds.Any())
                {
                    var allItems = await Supabase.From<OrderItem>().Get();
                    var validItems = allItems.Models.Where(i => orderIds.Contains(i.OrderId)).ToList();

                    foreach (var p in products)
                    {
                        double qty = validItems.Where(i => i.ItemName == p.Name).Sum(i => i.Quantity);
                        salesData[p.Name] = qty;
                    }
                }
            }

            analysisList = products.Select(p => new ProductAnalysisView
            {
                Name = p.Name,
                SellingPrice = p.SellingPrice,
                UnitVariableCost = p.CostPrice,
                SalesCount = salesData.ContainsKey(p.Name) ? salesData[p.Name] : 0,
                AllocatedFixedCost = 0
            }).Where(x => x.SalesCount > 0 || isForecastMode).ToList();

            CalculateMetrics();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"분석 오류: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateMetrics()
    {
        if (analysisList == null || !analysisList.Any()) return;

        totalSalesCount = analysisList.Sum(x => x.SalesCount);
        totalRevenue = analysisList.Sum(x => x.TotalRevenue);
        totalVariableCost = analysisList.Sum(x => x.TotalVariableCost);

        // 4. 비용 배분 로직 (핵심)
        if (TotalOperatingCost > 0)
        {
            foreach (var item in analysisList)
            {
                if (allocationMethod == "Quantity")
                {
                    // 판매량 비례
                    double share = totalSalesCount > 0 ? item.SalesCount / totalSalesCount : 0;
                    item.AllocatedFixedCost = TotalOperatingCost * share;
                }
                else
                {
                    // 매출액 비례
                    double share = totalRevenue > 0 ? item.TotalRevenue / totalRevenue : 0;
                    item.AllocatedFixedCost = TotalOperatingCost * share;
                }
            }
        }
        else
        {
            foreach (var item in analysisList) item.AllocatedFixedCost = 0;
        }

        // 5. 최종 순수익
        netProfit = totalRevenue - (totalVariableCost + TotalOperatingCost);

        analysisList = analysisList.OrderByDescending(x => x.TotalProfit).ToList();

        StateHasChanged();
    }

    private string GetMarginBadgeColor(double rate)
    {
        if (rate >= 30) return "bg-success";
        if (rate >= 15) return "bg-primary";
        if (rate >= 0) return "bg-warning text-dark";
        return "bg-danger";
    }
}

<style>
    .x-small {
        font-size: 0.75rem;
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #198754 0%, #20c997 100%);
    }

    .bg-gradient-danger {
        background: linear-gradient(135deg, #dc3545 0%, #f75c7e 100%);
    }
</style>